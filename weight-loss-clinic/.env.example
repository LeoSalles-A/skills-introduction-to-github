# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/weight_loss_clinic?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OpenAI API (for AI-powered lab analysis)
OPENAI_API_KEY="your-openai-api-key-here"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"

# SMS Configuration (for patient notifications)
SMS_API_KEY="your-sms-api-key"
SMS_API_SECRET="your-sms-api-secret"

# Application Configuration
NODE_ENV="development"
PORT="3000"

# Feature Flags
ENABLE_AI_ANALYSIS="true"
ENABLE_TELEMEDICINE="true"
ENABLE_DRIVE_THRU="true"

# File Upload
MAX_FILE_SIZE="10485760" # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# Session Configuration
SESSION_MAX_AGE="2592000" # 30 days in seconds
